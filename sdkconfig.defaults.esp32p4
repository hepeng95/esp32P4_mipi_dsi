# PSRAM: Octal, 200MHz (最高带宽)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y

# DMA2D 硬件加速 (LVGL flush 零 CPU 拷贝)
CONFIG_EXAMPLE_USE_DMA2D_COPY_FRAME=y

# ★★★ PPA 硬件加速 (开了翻 3 倍! alpha blend/fill/image scale) ★★★
CONFIG_LV_USE_PPA=y
CONFIG_LV_USE_PPA_IMG=y

# ★★★ PPA 必须 64 字节对齐 (ESP32-P4 L1 cache line=64) ★★★
CONFIG_LV_DRAW_BUF_ALIGN=64
CONFIG_LV_ATTRIBUTE_MEM_ALIGN_SIZE=64

# CPU 频率: 提升到最高性能
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_400=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=400

# Flash: QSPI 80MHz (最快安全模式)
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# 编译器优化: 发布级 (-O2 性能优先)
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y

# 关闭监控 GPIO (发布版不需要)
CONFIG_EXAMPLE_MONITOR_REFRESH_BY_GPIO=n

# FreeRTOS: 提高 tick 精度 (1000Hz = 1ms)
CONFIG_FREERTOS_HZ=1000

# 关闭 assert 调试输出 (发布版)
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_DISABLE=y

# 内存分配: PSRAM + 内部 reserve 防止 DMA 内存不足
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

# ★★★ LVGL 内置内存管理 (避免 heap 碎片 + 锁竞争) ★★★
CONFIG_LV_USE_BUILTIN_MALLOC=y
CONFIG_LV_MEM_SIZE_KILOBYTES=300              # 300KB 静态池 (BSS section)
CONFIG_LV_MEM_POOL_EXPAND_SIZE_KILOBYTES=0    # 禁止运行时扩展 (避免碎片化)

# LVGL 内部字符串/sprintf (零 RTOS 锁开销)
CONFIG_LV_USE_BUILTIN_STRING=y
CONFIG_LV_USE_BUILTIN_SPRINTF=y

# LVGL 字体: 启用多种字号用于 UI 层级
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_22=y
CONFIG_LV_FONT_MONTSERRAT_28=y

# ★★★ WDT: CPU1 不检查 IDLE (后台 render_task 会饿死 IDLE1) ★★★
CONFIG_ESP_TASK_WDT_TIMEOUT_S=15
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n
